# Security regression check — validate workflow file invariants
# BLOCKS the commit if ANY violation exists (baseline 0 since TASK-097,
# 2026-08-17 — all 12 F037 violations remediated). Previously tolerated up
# to 12 baseline violations (F037/F067); now zero-tolerance so a regression
# can never silently slip through the pre-commit gate again.
# Fail-open on parse error so a broken check never false-blocks.
# The `if` wrapper keeps this safe under `sh -e` (husky invokes hooks with
# `sh -e`) even though the check exits 1 whenever violations exist.
if output=$(node scripts/check-workflow-security.js --json 2>/dev/null); then
  :
fi
violations=$(printf '%s' "$output" | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).totalViolations)}catch(e){console.log('0')}})")
if [ "${violations:-0}" -gt 0 ]; then
  echo "⚠️  Workflow security VIOLATIONS: ${violations} found (baseline 0 since TASK-097). Run 'node scripts/check-workflow-security.js' to audit."
  exit 1
fi
echo "✅  Workflow security: ${violations} violations (baseline 0, TASK-097)."

npx lint-staged
